# Copy to .env (git-ignored) for local runs. Quarkus reads .env from the project root in dev mode.
# Infrastructure settings only; never commit real credentials.
# Customer integrations (CAPTCHA/OTP/risk) are NOT configured here: they live in flow JSON per step.

HTTP_PORT=8100
LOG_LEVEL=INFO

# PostgreSQL (datasource is wired in T004)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=onboarding
DB_SCHEMA=public
DB_USERNAME=onboarding
DB_PASSWORD=onboarding
